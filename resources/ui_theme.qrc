<RCC>
  <!-- QSS -->
  <qresource prefix="/theme">
    <file>qss/common.qss</file>
  </qresource>

  <!-- Fonts -->
  <qresource prefix="/theme">


    <file>fonts/Inter-Regular.ttf</file>
    <file>fonts/Inter-Medium.ttf</file>
    <file>fonts/Inter-Italic.ttf</file>
    <file>fonts/Inter-SemiBold.ttf</file>

    <file>fonts/JetBrainsMono-Regular.ttf</file>
    <file>fonts/JetBrainsMono-Medium.ttf</file>
    <file>fonts/JetBrainsMono-Italic.ttf</file>
    <file>fonts/JetBrainsMono-SemiBold.ttf</file>

    <file>fonts/InterVariable.ttf</file>
    <file>fonts/InterVariable-Italic.ttf</file>
    <file>fonts/JetBrainsMono[wght].ttf</file>
    <file>fonts/JetBrainsMono-Italic[wght].ttf</file>
    <file>fonts/OFL.txt</file> <!-- license(s) -->
  </qresource>

  <!-- Icons -->
  <qresource prefix="/theme">
    <file>icons/app_icon.png</file>
    <file>icons/open_dark.svg</file>
    <file>icons/open_light.svg</file>
    <file>icons/save_dark.svg</file>
    <file>icons/save_light.svg</file>
    <file>icons/mission_add_node.svg</file>
    <file>icons/mission_attacker.png</file>
    <file>icons/mission_border.png</file>
    <file>icons/mission_corner.png</file>
    <file>icons/mission_delete_node.svg</file>
    <file>icons/mission_drone.png</file>
    <file>icons/mission_edge.svg</file>
    <file>icons/mission_generic.png</file>
    <file>icons/mission_grid.svg</file>
    <file>icons/mission_redo.svg</file>
    <file>icons/mission_target.svg</file>
    <file>icons/mission_undo.svg</file>
  </qresource>

</RCC>
