    {
      "name": "mac-debug",
      "configurePreset": "mac-debug",
      "jobs": 0
    },
    {
      "name": "mac-debug-asan",
      "configurePreset": "mac-debug-asan",
      "jobs": 0
    },
    {
      "name": "mac-debug-tsan",
      "configurePreset": "mac-debug-tsan",
      "jobs": 0
    },
    {
      "name": "mac-release",
      "configurePreset": "mac-release",
      "jobs": 0
    },
    {
      "name": "win-debug",
      "configurePreset": "win-debug",
      "jobs": 0
    },
    {
      "name": "win-debug-asan",
      "configurePreset": "win-debug-asan",
      "jobs": 0
    },
    {
      "name": "win-debug-tsan",
      "configurePreset": "win-debug-tsan",
      "jobs": 0
    },
    {
      "name": "win-release",
      "configurePreset": "win-release",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug-asan",
      "configurePreset": "linux-debug-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug-tsan",
      "configurePreset": "linux-debug-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mac-debug",
      "configurePreset": "mac-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mac-debug-asan",
      "configurePreset": "mac-debug-asan",
