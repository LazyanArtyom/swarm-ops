    {
      "label": "configure-debug",
      "type": "shell",
      "command": "cmake --preset linux-debug",
      "linux": {
        "command": "cmake --preset linux-debug"
      },
      "osx": {
        "command": "cmake --preset mac-debug"
      },
      "windows": {
        "command": "C:\\msys64\\msys2_shell.cmd",
        "args": [
          "-defterm",
          "-no-start",
          "-mingw64",
          "-here",
          "-lc",
          "if [ -f ~/.venvs/conan2/bin/activate ]; then source ~/.venvs/conan2/bin/activate; fi; cmake --preset win-debug"
        ]
      }
    },
