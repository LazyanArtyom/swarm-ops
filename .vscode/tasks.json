    {
      "label": "copy-compile-commands-debug",
      "type": "shell",
      "command": "cp build/linux-debug/compile_commands.json ./ && touch compile_commands.json",
      "linux": {
        "command": "cp build/linux-debug/compile_commands.json ./ && touch compile_commands.json"
      },
      "osx": {
        "command": "cp build/mac-debug/compile_commands.json ./ && touch compile_commands.json"
      },
      "windows": {
        "command": "C:\\msys64\\msys2_shell.cmd",
        "args": [
          "-defterm",
          "-no-start",
          "-mingw64",
          "-here",
          "-lc",
          "cp build/win-debug/compile_commands.json ./compile_commands.json && touch compile_commands.json"
        ]
      },
      "dependsOn": [
        "build-debug"
      ]
    },
    {
      "label": "copy-compile-commands-release",
      "type": "shell",
      "command": "cp build/linux-release/compile_commands.json ./ && touch compile_commands.json",
