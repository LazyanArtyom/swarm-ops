    {
      "label": "deploy: installer",
      "type": "shell",
      "command": "bash",
      "linux": {
        "command": "bash",
        "args": [
          "-lc",
          "chmod +x packaging/scripts/make_installer_linux.sh && packaging/scripts/make_installer_linux.sh build/linux-release"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "-lc",
          "chmod +x packaging/scripts/make_installer_mac.sh && packaging/scripts/make_installer_mac.sh build/mac-release"
        ]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$env:CMAKE_COMMAND='C:\\msys64\\mingw64\\bin\\cmake.exe'; $env:PATH='C:\\Qt\\6.8.3\\mingw_64\\bin;C:\\Qt\\Tools\\mingw1310_64\\bin;'+$env:PATH; packaging\\scripts\\make_installer_win.bat \"build\\win-release\" \"$PWD\""
        ]
      },
