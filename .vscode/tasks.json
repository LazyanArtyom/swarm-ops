    {
      "label": "clang-tidy: file",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/run-clang-tidy.sh",
        "build/linux-debug",
        "${file}"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/run-clang-tidy.sh",
          "build/linux-debug",
          "${file}"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/run-clang-tidy.sh",
          "build/mac-debug",
          "${file}"
        ]
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\run-clang-tidy.ps1",
          "build\\win-debug",
          "${file}"
        ]
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "clang-tidy: project",
      "type": "process",
      "command": "bash",
      "args": [
